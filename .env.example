# ============================================================
# Liburan Pintar — Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai:
#   cp .env.example .env
# ============================================================

# Database PostgreSQL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/plenger?schema=public"

# Secret untuk JWT session token (generate: openssl rand -hex 32)
JWT_SECRET="your_jwt_secret_here"

# RapidAPI Key — untuk Booking.com & Skyscanner API
# Daftar di: https://rapidapi.com/
RAPIDAPI_KEY="your_rapidapi_key_here"

# OpenTripMap API Key — untuk fetch Points of Interest
# Daftar di: https://opentripmap.io/
OPENTRIPMAP_KEY="your_opentripmap_key_here"
